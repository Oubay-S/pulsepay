# PulsePay — Environment Variables Example
# PayPal AI Hackathon 2026

# Server Port / Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Postgres & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayPal Sandbox Credentials
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# PayPal browser SDK (safe to expose; same value as PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

# Optional: Sandbox personal (buyer) account email used by the Phase 0 spike
PAYPAL_TEST_BUYER_EMAIL=your-sandbox-buyer@example.com

# DANGER: local experiments only. Never set this in production or in the demo.
# When "true", PayPal webhook signatures are NOT verified.
# PAYPAL_WEBHOOK_SKIP_VERIFY=false

# AI Providers (Free Tiers: Primary + Fallback)
# Primary: Google AI Studio (Gemini 2.0 Flash)
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_API_KEY=your-gemini-api-key
LLM_PRIMARY_MODEL=gemini-2.0-flash

# Fallback: Groq (Llama 3.1 70B) or OpenRouter
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_API_KEY=your-groq-api-key
LLM_FALLBACK_MODEL=llama-3.1-70b-versatile

# Email Notifications (Resend - Free Tier)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="PulsePay <notifications@resend.dev>"

# Optional Security / Cron Token
CRON_SECRET=pulsepay-local-cron-secret

